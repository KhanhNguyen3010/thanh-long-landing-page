<!DOCTYPE html>

<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Công ty Thanh Long - Xuất Khẩu Lao Động &amp; Du Học</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&amp;family=Inter:wght@400;600&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "surface-dim": "#d8dadc",
                        "inverse-primary": "#a9c7ff",
                        "on-primary": "#ffffff",
                        "secondary-fixed": "#ffdcc5",
                        "success-green-light": "#EBF7ED",
                        "secondary": "#944a00",
                        "tertiary-fixed-dim": "#61de8a",
                        "on-primary-fixed": "#001b3d",
                        "tertiary": "#003216",
                        "on-primary-fixed-variant": "#0e4686",
                        "outline": "#737781",
                        "on-secondary-container": "#663100",
                        "surface-container-highest": "#e0e3e5",
                        "on-error": "#ffffff",
                        "on-background": "#191c1e",
                        "surface-container-high": "#e6e8ea",
                        "inverse-surface": "#2d3133",
                        "surface-variant": "#e0e3e5",
                        "secondary-container": "#fc8f34",
                        "primary-container": "#004080",
                        "primary-fixed-dim": "#a9c7ff",
                        "primary-fixed": "#d6e3ff",
                        "on-error-container": "#93000a",
                        "on-secondary-fixed": "#301400",
                        "surface-container-low": "#f2f4f6",
                        "error-container": "#ffdad6",
                        "on-surface-variant": "#424750",
                        "on-tertiary": "#ffffff",
                        "tertiary-container": "#004b24",
                        "background": "#f7f9fb",
                        "on-secondary-fixed-variant": "#713700",
                        "error": "#ba1a1a",
                        "on-tertiary-fixed": "#00210c",
                        "on-surface": "#191c1e",
                        "surface-bright": "#f7f9fb",
                        "amber-soft": "#FFF4E6",
                        "on-secondary": "#ffffff",
                        "surface-container": "#eceef0",
                        "on-tertiary-fixed-variant": "#005228",
                        "secondary-fixed-dim": "#ffb783",
                        "outline-variant": "#c3c6d2",
                        "surface": "#f7f9fb",
                        "tertiary-fixed": "#7efba4",
                        "surface-tint": "#305ea0",
                        "surface-container-lowest": "#ffffff",
                        "on-tertiary-container": "#42c372",
                        "ink-black": "#0F172A",
                        "slate-gray": "#64748B",
                        "inverse-on-surface": "#eff1f3",
                        "on-primary-container": "#83aef5",
                        "primary": "#004080",
                        "trust-blue-dark": "#002B56"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    "spacing": {
                        "stack-lg": "32px",
                        "stack-md": "16px",
                        "stack-sm": "8px",
                        "margin-mobile": "16px",
                        "gutter": "24px",
                        "section-padding": "80px",
                        "container-max": "1200px"
                    },
                    "fontFamily": {
                        "body-md": ["Inter"],
                        "body-lg": ["Inter"],
                        "headline-md": ["Montserrat"],
                        "label-bold": ["Inter"],
                        "caption": ["Inter"],
                        "display-lg": ["Montserrat"],
                        "headline-sm": ["Montserrat"],
                        "display-lg-mobile": ["Montserrat"]
                    },
                    "fontSize": {
                        "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }],
                        "headline-md": ["32px", { "lineHeight": "40px", "fontWeight": "600" }],
                        "label-bold": ["14px", { "lineHeight": "20px", "fontWeight": "600" }],
                        "caption": ["12px", { "lineHeight": "16px", "fontWeight": "400" }],
                        "display-lg": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "headline-sm": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "display-lg-mobile": ["32px", { "lineHeight": "40px", "fontWeight": "700" }]
                    }
                }
            }
        }
    </script>
</head>

<body class="bg-background text-on-background font-body-md antialiased">
    <!-- Header Navigation -->
    <header
        class="bg-surface-container-lowest/90 backdrop-blur-md text-primary font-headline-sm text-headline-sm docked full-width top-0 sticky border-b border-outline-variant shadow-sm z-50">
        <div
            class="flex justify-between items-center w-full px-margin-mobile md:px-gutter max-w-container-max mx-auto h-20">
            <div class="flex items-center gap-2">
                <img alt="Thanh Long Logo" class="h-12 w-auto"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuBTIb1kIb6SEawijvrHf9IzUyubkEPfSNhKlCPJ__v6ANo_KhVIiPavAq1sE2pWOSRBzLG_PURP7pwvWtoG76wxNKsampm6LQJ1R7Xvox5DMrYQ1wdJcrvN2AvNDt9EoU3WIHKZEHh8ouNpyzSrHCqpZOr89_Fp12jymoXeutfiKxjRxfiC8O0QQQ1kBmbfmOx6HDs-W2cZweSpsvpGAHRf0shVrVEmvY4VwWiD_-EMtr2SxPqhIrXopP2eopRq45SfpVw" />
            </div>
            <nav class="hidden md:flex gap-8">
                <a class="text-primary font-label-bold text-label-bold hover:text-secondary transition-colors"
                    href="#">Trang chủ</a>
                <a class="text-on-surface-variant font-label-bold text-label-bold hover:text-primary transition-colors"
                    href="#about">Về chúng tôi</a>
                <a class="text-on-surface-variant font-label-bold text-label-bold hover:text-primary transition-colors"
                    href="#programs">Chương trình</a>
                <a class="text-on-surface-variant font-label-bold text-label-bold hover:text-primary transition-colors"
                    href="#workflow">Quy trình</a>
                <a class="text-on-surface-variant font-label-bold text-label-bold hover:text-primary transition-colors"
                    href="#gallery">Thư viện ảnh</a>
                <a class="text-on-surface-variant font-label-bold text-label-bold hover:text-primary transition-colors"
                    href="#faq">FAQ</a>
            </nav>
            <a class="hidden md:inline-flex bg-primary text-on-primary px-6 py-2.5 rounded-full font-label-bold hover:bg-primary-container transition-colors shadow-sm"
                href="#contact">Tư vấn: 0962.581.175</a>
            <button class="md:hidden text-primary">
                <span class="material-symbols-outlined" data-icon="menu">menu</span>
            </button>
        </div>
    </header>
    <!-- Hero Section -->
    <section class="relative h-[80vh] flex items-center justify-center bg-surface-container">
        <div class="absolute inset-0 z-0"
            data-alt="A sweeping, dramatic drone shot of Lunenburg, Canada, featuring colorful historic houses nestled along a rocky coastline with a brilliant blue ocean. The autumn foliage is vibrant with deep reds and oranges. The sky is bright with soft clouds, conveying a sense of vast opportunity and international aspiration in a highly professional, modern light-mode aesthetic."
            style="background-image: url('assets/img/Bản\ sao\ screen.png'); background-size: cover; background-position: center;">
            <div class="absolute inset-0 bg-primary/50 mix-blend-multiply"></div>
        </div>
        <div
            class="relative z-10 text-center px-margin-mobile md:px-gutter max-w-container-max mx-auto text-on-primary">
            <h1
                class="font-display-lg-mobile text-display-lg-mobile md:font-display-lg md:text-display-lg font-bold mb-stack-md text-white drop-shadow-lg">
                ĐỒNG HÀNH CÙNG BẠN VƯƠN TẦM THẾ GIỚI
            </h1>
            <p class="font-body-lg text-body-lg mb-stack-lg max-w-2xl mx-auto text-white/90 drop-shadow-md">
                Chuyên gia tư vấn định cư, xuất khẩu lao động và du học uy tín hàng đầu.
            </p>
            <a class="inline-flex items-center gap-2 bg-secondary text-on-primary px-8 py-4 rounded-full font-label-bold text-lg hover:bg-secondary-container hover:text-on-secondary-container transition-transform hover:scale-105 shadow-xl"
                href="#programs">
                Khám phá lộ trình <span class="material-symbols-outlined" data-icon="arrow_forward">arrow_forward</span>
            </a>
        </div>
    </section>
    <!-- About Us Section -->
    <section class="py-section-padding bg-surface" id="about">
        <div class="px-margin-mobile md:px-gutter max-w-container-max mx-auto">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-stack-lg items-center">
                <div class="relative h-[500px] rounded-3xl overflow-hidden shadow-2xl">
                    <img alt="Tư vấn xuất khẩu lao động" class="absolute inset-0 w-full h-full object-cover"
                        src="https://lh3.googleusercontent.com/aida-public/AB6AXuAEsB3qouEpKSRdKhe_JxojbQwDEDz7h59VCqLfGieRlg1fkk_X0jiiLP2ucXoDuw_ikNgniDCzgK5--vbSqlRp8Y36uXqSqNRqzDQujDpph-uPdMTAR0qa84CRxTwoFUAV9_YDOgoAPnAt2knRkwEnR_lmvVasMOfDi1ZMbheN5DiYLjzD21ed8lzYufyG39I7JZ-liiUag1lxLvvRsDZUiv7tscP0xT_aY788rNX7ygEYfOAS--f7iU--p8UwJgu7XwQ" />
                    <div class="absolute inset-0 bg-gradient-to-t from-primary/80 to-transparent"></div>
                    <div class="absolute bottom-8 left-8 right-8 text-on-primary">
                        <h3 class="font-headline-sm text-headline-sm font-bold mb-2">Hơn 10 năm kinh nghiệm</h3>
                        <p class="font-body-md opacity-90">Đồng hành cùng hàng ngàn lao động Việt</p>
                    </div>
                </div>
                <div class="space-y-6">
                    <h2 class="font-headline-md text-headline-md text-primary font-bold">Về Chúng Tôi</h2>
                    <div class="h-1 w-20 bg-secondary rounded-full"></div>
                    <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
                        <strong class="text-primary font-bold">CÔNG TY TNHH TM &amp; TƯ VẤN XNK THANH LONG (MST:
                            0901139180)</strong> tự hào là đơn vị uy tín trong lĩnh vực tư vấn du học và xuất khẩu lao
                        động.
                    </p>
                    <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
                        Sứ mệnh của chúng tôi là định hướng tương lai bền vững cho lao động và học sinh Việt Nam, giúp
                        các bạn vươn tầm thế giới với lộ trình minh bạch và hiệu quả.
                    </p>
                    <ul class="space-y-3 mt-4">
                        <li class="flex items-center gap-3 text-on-surface">
                            <span class="material-symbols-outlined text-secondary">verified</span>
                            <span class="font-label-bold">Tư vấn tận tâm, chuyên nghiệp</span>
                        </li>
                        <li class="flex items-center gap-3 text-on-surface">
                            <span class="material-symbols-outlined text-secondary">verified</span>
                            <span class="font-label-bold">Thủ tục nhanh gọn, minh bạch</span>
                        </li>
                        <li class="flex items-center gap-3 text-on-surface">
                            <span class="material-symbols-outlined text-secondary">verified</span>
                            <span class="font-label-bold">Hỗ trợ trọn đời</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>
    <!-- Core Services Section -->
    <section class="py-section-padding bg-surface-container-low" id="programs">
        <div class="px-margin-mobile md:px-gutter max-w-container-max mx-auto">
            <div class="text-center mb-stack-lg">
                <h2 class="font-headline-md text-headline-md text-primary mb-stack-sm font-bold">Chương Trình Trọng Điểm
                </h2>
                <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mx-auto">Cơ hội làm việc và định
                    cư tại các quốc gia phát triển với lộ trình rõ ràng, minh bạch.</p>
            </div>
            <!-- Bento Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
                <!-- Canada -->
                <div
                    class="bg-surface-container-lowest rounded-2xl overflow-hidden shadow-sm border border-outline-variant hover:shadow-xl transition-all hover:-translate-y-1 flex flex-col h-full md:col-span-2 row-span-2 group">
                    <div class="h-64 md:h-[400px] w-full relative overflow-hidden"
                        data-alt="A stunning view of Lunenburg Canada with bright autumn leaves, colorful houses, and calm blue waters under a clear sky. The scene is majestic and inspiring, perfectly matching the premium, aspirational corporate modernism aesthetic of the overseas labor agency."
                        style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCyss7vFf0C-zgsEj6HPHhR-dCSRNcJnJZ1VygxEMwzW0MliirHK4BGzGK4RJE45lXXT3Lwxhiv_tXo1E7WI5EdOlNHmnd2E7t56y6GTc5UfwomHXjqdk0hYgwIAjlaGIVCg9F6geTECYC_od_YedokeFBf7CRSAQc_5qSOoRAhux177BJQkVaR92BmaWXcOWymLH2YTPmhVg1fWKK0KEIMNOLl2eWpdNTDnNSM3V8n8P-FVXIAK92kLHlnHdfaFib8DYM'); background-size: cover; background-position: center;">
                        <div class="absolute inset-0 bg-primary/20 group-hover:bg-transparent transition-colors"></div>
                    </div>
                    <div class="p-stack-lg flex-1 flex flex-col">
                        <div class="flex justify-between items-start mb-4">
                            <h3
                                class="font-headline-sm text-headline-sm text-primary font-bold flex items-center gap-2">
                                Canada <span class="material-symbols-outlined text-secondary"
                                    data-icon="star">star</span></h3>
                            <span
                                class="bg-primary-container text-on-primary-container px-3 py-1 rounded-full text-xs font-label-bold">HOT</span>
                        </div>
                        <p class="font-body-lg text-body-lg text-on-surface-variant mb-6 flex-1">Định cư và làm việc lâu
                            dài với nhiều ngành nghề đa dạng, thu nhập hấp dẫn, môi trường sống chất lượng cao hàng đầu
                            thế giới.</p>
                        <ul class="space-y-3 mb-8">
                            <li class="flex items-center gap-3"><span class="material-symbols-outlined text-secondary"
                                    data-icon="check_circle">check_circle</span> Lương cao, phúc lợi tốt</li>
                            <li class="flex items-center gap-3"><span class="material-symbols-outlined text-secondary"
                                    data-icon="check_circle">check_circle</span> Cơ hội mang theo gia đình</li>
                            <li class="flex items-center gap-3"><span class="material-symbols-outlined text-secondary"
                                    data-icon="check_circle">check_circle</span> Lộ trình thẻ xanh rõ ràng</li>
                        </ul>
                        <div class="mt-auto flex gap-3">
                            <button onclick="openModal('canadaModal')"
                                class="flex-1 text-center w-full bg-surface-container text-primary py-3 rounded-xl font-label-bold hover:bg-primary/10 transition-colors shadow-sm border border-outline-variant">Chi
                                Tiết</button>
                            <a class="flex-1 block text-center w-full bg-primary text-on-primary py-3 rounded-xl font-label-bold hover:bg-primary-container hover:text-on-primary-container transition-colors shadow-md"
                                href="#contact">Tư Vấn Ngay</a>
                        </div>
                    </div>
                </div>
                <!-- Ireland -->
                <div
                    class="bg-surface-container-lowest rounded-2xl overflow-hidden shadow-sm border border-outline-variant hover:shadow-lg transition-shadow flex flex-col h-full group">
                    <div class="h-48 w-full overflow-hidden"
                        data-alt="A smiling man holding freshly harvested mushrooms in a bright, clean, modern greenhouse in Ireland. The environment looks professional, safe, and welcoming, embodying the reliable and supportive tone of the labor export service."
                        style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuDIdsTmtuUvX-ohiIZXwicTpB-fjCI4JQJj51sR3TAU9P0dIkQsok2XUZYnmva7dpAwFDiGye9N197U9SU6zKSc7IQOlRina85QRJLXx_g1YQto4j5oQkeA5ktiuB3VO2Zo9BP5yxdIpLI2Y1NB1f7daD5MpwcWF7pncXX6YnhS3d1Y6xqIEN6MG1q0VAyrzrVEOXLgpH5B6_UGT7SmG0iyFWMVzWH9YJSQu6UPtkGJ6JGsAyTACESon6chN6Ia_csoNDg'); background-size: cover; background-position: center;">
                    </div>
                    <div class="p-stack-md flex-1 flex flex-col">
                        <h3 class="font-headline-sm text-headline-sm text-primary mb-2 font-bold">Ireland</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant mb-4 flex-1">Chương trình hái nấm
                            thu nhập ổn định.</p>
                        <div
                            class="bg-success-green-light text-tertiary-container px-3 py-1 rounded inline-block text-sm font-label-bold mb-6 self-start">
                            ~ 14 EUR/h</div>
                        <div class="mt-auto flex gap-2">
                            <button onclick="openModal('irelandModal')"
                                class="flex-1 text-center w-full bg-surface-container text-primary py-2.5 rounded-lg font-label-bold hover:bg-primary/10 transition-colors shadow-sm border border-outline-variant">Chi
                                Tiết</button>
                            <a class="flex-1 block text-center w-full bg-primary text-on-primary py-2.5 rounded-lg font-label-bold hover:bg-primary-container hover:text-on-primary-container transition-colors shadow-md"
                                href="#contact">Tư Vấn Ngay</a>
                        </div>
                    </div>
                </div>
                <!-- USA EB-3 -->
                <div
                    class="bg-surface-container-lowest rounded-2xl overflow-hidden shadow-sm border border-outline-variant hover:shadow-lg transition-shadow flex flex-col h-full group">
                    <div class="h-48 w-full overflow-hidden"
                        data-alt="A happy family standing in front of a subtly waving American flag and the Statue of Liberty. The lighting is bright and optimistic, reflecting a successful immigration journey and a stable, high-end corporate lifestyle aesthetic."
                        style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuAQlcQIYVrOBRXotY-5cTExeqfF5NoWgDjA2tvz2D0ozLOKxcgpPx8r6SBtfV6DX_6F6iNiAPFAkk1fuOjjiWDchAI6QQhIuWxG2u55GW_7j-RhmIAhS27w6kbeAue37nIg730NG8kalKrXIGW8MYx8D6RR6yqytX_v4HFATTvfw_SroSDM8OSZnDiz98YB2xQ7RtLpu_MWL4MDKANKedw73HZ6ikMMi-VEIYGvP5YQ1WwysoJn5wvkVzLaUD3-S_D2G38'); background-size: cover; background-position: center;">
                    </div>
                    <div class="p-stack-md flex-1 flex flex-col">
                        <h3 class="font-headline-sm text-headline-sm text-primary mb-2 font-bold">USA (EB-3)</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant mb-4 flex-1">Định cư Mỹ diện lao
                            động phổ thông.</p>
                        <ul class="space-y-1 mb-6 text-sm">
                            <li class="flex items-center gap-2"><span
                                    class="material-symbols-outlined text-secondary text-sm"
                                    data-icon="done">done</span> Lấy thẻ xanh cho cả gia đình</li>
                        </ul>
                        <div class="mt-auto flex gap-2">
                            <button onclick="openModal('usaModal')"
                                class="flex-1 text-center w-full bg-surface-container text-primary py-2.5 rounded-lg font-label-bold hover:bg-primary/10 transition-colors shadow-sm border border-outline-variant">Chi
                                Tiết</button>
                            <a class="flex-1 block text-center w-full bg-primary text-on-primary py-2.5 rounded-lg font-label-bold hover:bg-primary-container hover:text-on-primary-container transition-colors shadow-md"
                                href="#contact">Tư Vấn Ngay</a>
                        </div>
                    </div>
                </div>
                <!-- Lithuania -->
                <div
                    class="bg-surface-container-lowest rounded-2xl overflow-hidden shadow-sm border border-outline-variant hover:shadow-lg transition-shadow flex flex-col h-full group">
                    <div class="h-48 w-full overflow-hidden"
                        data-alt="A professional young woman working diligently in a clean, modern logistics center in Lithuania, packing boxes with tape. The background shows a beautifully sunlit Lithuanian cityscape, conveying a safe, structured, and lucrative European work environment."
                        style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuC4IaqZYqSuKfxCYsJGtaIzV4Dp1gTj9mTlE_qN-4Yk1ih85u4foWuSh0JfBAGysQ5BP76okrhkjaCcZv2gj_bfEpfUKsNVMx4Mr9BK7pbrKFOXU2kxRluGlKM4kAiJmOfXn0mjJXLhcgMQAlrCUeAWrIyL2J_4JG9w8AGHV_2Mw6Ch3XEzq4Zv5L3PjBP7wFnbkVBGBl8dWSQ8SSTnei1XlQa_OwNWM-kTy6pehOKhnM8r9SfGXxWQdB0adyktpaMSYs4'); background-size: cover; background-position: center;">
                    </div>
                    <div class="p-stack-md flex-1 flex flex-col">
                        <h3 class="font-headline-sm text-headline-sm text-primary mb-2 font-bold">Litva</h3>
                        <p class="font-body-md text-body-md text-on-surface-variant mb-4 flex-1">Nhân viên đóng gói
                            (Packer) với thu nhập hấp dẫn.</p>
                        <div
                            class="bg-success-green-light text-tertiary-container px-3 py-1 rounded inline-block text-sm font-label-bold mb-6 self-start">
                            Từ 900 EUR Net</div>
                        <div class="mt-auto flex gap-2">
                            <button onclick="openModal('litvaModal')"
                                class="flex-1 text-center w-full bg-surface-container text-primary py-2.5 rounded-lg font-label-bold hover:bg-primary/10 transition-colors shadow-sm border border-outline-variant">Chi
                                Tiết</button>
                            <a class="flex-1 block text-center w-full bg-primary text-on-primary py-2.5 rounded-lg font-label-bold hover:bg-primary-container hover:text-on-primary-container transition-colors shadow-md"
                                href="#contact">Tư Vấn Ngay</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Timeline Section -->
    <section class="py-section-padding bg-surface overflow-hidden relative" id="workflow">
        <!-- Decorative background elements -->
        <div class="absolute top-0 left-1/4 w-96 h-96 bg-primary/5 rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-secondary/5 rounded-full blur-3xl"></div>

        <div class="px-margin-mobile md:px-gutter max-w-container-max mx-auto relative z-10">
            <div class="text-center mb-16 md:mb-24">

                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="p-6">
                <div class="overflow-x-auto rounded-xl border border-outline-variant">
                    <table class="w-full text-left border-collapse min-w-[700px]">
                        <thead>
                            <tr class="bg-success-green-light border-b border-outline-variant">
                                <th
                                    class="p-3 font-bold text-tertiary-container w-16 text-center border-r border-outline-variant">
                                    Stt</th>
                                <th class="p-3 font-bold text-tertiary-container w-1/3 border-r border-outline-variant">
                                    Hạng mục</th>
                                <th class="p-3 font-bold text-tertiary-container">Nội dung</th>
                            </tr>
                        </thead>
                        <tbody class="text-on-surface-variant text-sm md:text-base divide-y divide-outline-variant">
                            <tr>
                                <td class="p-3 font-bold text-center border-r border-outline-variant">1</td>
                                <td class="p-3 font-bold border-r border-outline-variant">Công việc tiếp nhận:</td>
                                <td class="p-3 font-bold text-primary">NÔNG NGHIỆP</td>
                            </tr>
                            <tr>
                                <td class="p-3 font-bold text-center border-r border-outline-variant">2</td>
                                <td class="p-3 font-bold border-r border-outline-variant">Địa điểm làm việc:</td>
                                <td class="p-3 font-bold text-primary">CANADA</td>
                            </tr>
                            <tr>
                                <td class="p-3 font-bold text-center border-r border-outline-variant">3</td>
                                <td class="p-3 font-bold border-r border-outline-variant">Ngành nghề xin visa:</td>
                                <td class="p-3">Visa lao động</td>
                            </tr>
                            <tr>
                                <td class="p-3 font-bold text-center border-r border-outline-variant">4</td>
                                <td class="p-3 font-bold border-r border-outline-variant">Tên và nội dung CV cụ thể:
                                </td>
                                <td class="p-3 font-bold">Làm việc tại FARM</td>
                            </tr>
                            <tr>
                                <td class="p-3 font-bold text-center border-r border-outline-variant">5</td>
                                <td class="p-3 font-bold border-r border-outline-variant">Điều kiện tuyển dụng:</td>
                                <td class="p-3">
                                    <div class="flex flex-wrap gap-x-8 gap-y-2">
